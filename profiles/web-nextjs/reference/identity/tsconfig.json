{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "strict": true, "noUncheckedIndexedAccess": true, "exactOptionalPropertyTypes": true,
    "noEmit": true, "skipLibCheck": true, "types": ["vitest/globals", "node"],
    "paths": { "@app/kernel": ["../../kernel/src/index.ts"] }
  },
  "include": ["src", "test"],
  "exclude": ["src/infra/prisma"]
}
