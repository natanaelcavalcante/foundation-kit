// prisma/schema/identity.prisma
enum StatusUsuario {
  PENDENTE_VERIFICACAO
  ATIVO
  BLOQUEADO
  DESATIVADO
}

enum MetodoMfa {
  TOTP
  EMAIL
}

model Usuario {
  id                  String        @id @db.Uuid
  email               String        @unique
  nome                String
  senhaHash           String
  status              StatusUsuario @default(PENDENTE_VERIFICACAO)
  mfaSegredoCifrado   String?
  mfaConfirmado       Boolean       @default(false)
  mfaMetodoPreferido  MetodoMfa     @default(TOTP)
  mfaUltimoPassoTotp  Int?
  codigosRecuperacao  String[]      @default([])
  criadoEm            DateTime      @default(now())
  atualizadoEm        DateTime      @updatedAt

  @@map("usuario")
}
